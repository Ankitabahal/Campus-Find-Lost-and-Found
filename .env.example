# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server & CORS
PORT=3000
CLIENT_URL="http://localhost:3000,http://localhost:5173"

# Security
JWT_SECRET="replace_with_a_long_random_secret_in_production"

# Database configuration
# Production (Railway MySQL): provide MYSQL_URL (or MYSQLHOST/MYSQLPORT/MYSQLUSER/MYSQLPASSWORD/MYSQLDATABASE)
# or DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME.
# Local isolated dev fallback: leave MYSQL_URL / DB_HOST empty or set DB_DRIVER=sqlite.
DB_DRIVER="auto"
MYSQL_URL=""
DB_HOST=""
DB_PORT="3306"
DB_USER=""
DB_PASSWORD=""
DB_NAME="smart_lost_found"
LOCAL_SQLITE_PATH=".local-dev/campusfind.sqlite"

# Initial Admin Seed (only used when admin account does not exist yet)
ADMIN_EMAIL="admin@campusfind.edu"
ADMIN_PASSWORD="ChangeMe123!"

# Frontend build configuration (for standalone Vercel client deployment)
VITE_API_URL="/api"
VITE_ASSET_URL=""
