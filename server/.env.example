PORT=5000
# Comma-separated list of allowed frontend origins (e.g. Vercel domain + localhost)
CLIENT_URL=http://localhost:3000,http://localhost:5173

# Railway MySQL: set MYSQL_URL (or MYSQLHOST/MYSQLPORT/MYSQLUSER/MYSQLPASSWORD/MYSQLDATABASE)
# or standard DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME variables.
# Leave MYSQL_URL and DB_HOST empty to use the isolated local SQLite dev database.
DB_DRIVER=auto
MYSQL_URL=
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=smart_lost_found

JWT_SECRET=replace_this_with_a_long_random_secret
ADMIN_EMAIL=admin@campusfind.edu
ADMIN_PASSWORD=ChangeMe123!
